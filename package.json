{
  "name": "@rehearsal-labs/retest",
  "version": "0.0.0",
  "private": true,
  "description": "One test across web, mobile and desktop. Built for software engineers and coding agents.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rehearsal-labs/retest.git"
  },
  "homepage": "https://github.com/rehearsal-labs/retest#readme",
  "bugs": {
    "url": "https://github.com/rehearsal-labs/retest/issues"
  },
  "engines": {
    "node": ">=24.12"
  },
  "bin": {
    "retest": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "retest-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "retest-source": "./src/runner/index.ts",
      "types": "./dist/runner/index.d.ts",
      "default": "./dist/runner/index.js"
    },
    "./protocol": {
      "retest-source": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./playwright": {
      "retest-source": "./src/playwright/index.ts",
      "types": "./dist/playwright/index.d.ts",
      "default": "./dist/playwright/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/write-schemas.ts",
    "typecheck": "tsc -p tsconfig.json && node_modules/typescript-7/bin/tsc -p tsconfig.json && tsc -p examples/tasks/tsconfig.json",
    "test:unit": "node --conditions=retest-source --test \"tests/unit/**/*.test.ts\"",
    "test:types": "node tests/types/run.ts",
    "test:integration": "node --conditions=retest-source --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:types && npm run test:integration",
    "bench": "node benchmarks/run.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2"
  }
}